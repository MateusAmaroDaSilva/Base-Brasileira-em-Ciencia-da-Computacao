# Banco de dados PostgreSQL
POSTGRES_USER=bbcc_user
POSTGRES_PASSWORD=troque_esta_senha_segura
POSTGRES_DB=base_computacao

# Dominio fornecido pela universidade (ex: bbcc.labs.unimar.br)
DOMAIN=bbcc.labs.unimar.br

# Versao das imagens no GHCR, sem o "v" (ex: 1.0.0).
# Trocar aqui e atualizar a stack e como se sobe uma versao nova ou se volta para a anterior.
TAG=1.0.0

# Chave que assina os tokens de login. Obrigatoria em producao: sem ela a API nao sobe.
# Gere uma com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
